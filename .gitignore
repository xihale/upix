# Models (large files — distributed via GitHub release, never committed)
*.bin
*.param
*.onnx
*.tflite
*.ncnn
cli/models/
!models/README.md
models/manifest.json
# Machine-local model store symlink (e.g. -> ~/.config/Upix/models)
models/models

# Logs
*.log
logs/

# Test / debug outputs
test_output/
*.png
*.jpg
*.jpeg
*.webp
!docs/*.png
!docs/*.jpg
# Model-effect oracle goldens (tests/model_oracle/golden/): reference images
# committed on purpose — they are the regression baseline, not build output.
!tests/model_oracle/golden/*.png
# Landing-page pair (site/public/images/*.webp): these files are shipped, not
# build output.
!site/public/images/*.webp

# Landing-page build output and dependencies
site/node_modules/
site/dist/

# Release signing (never commit; lives in ~/.config/upix and GH secrets)
*.jks
*.keystore
*.p12

# Temporary files
tmp/
temp/
*.tmp
.tmp_*

# Benchmark artifacts
gpu_*.csv
gpu_*.txt
gpu_*.log

# python
__pycache__/
