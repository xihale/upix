<?xml version="1.0" encoding="utf-8"?>
<!-- Upix launcher foreground: "layered upscale" mark.
     A small outlined square (the source frame) tucked behind a larger solid
     square (the upscaled result), offset along the diagonal.
     Colors follow ui/theme/Color.kt: Teal300 #AEDFD9 outline, Teal600 #4C9D9A fill.
     All geometry stays inside the 66dp adaptive-icon safe zone (center 54,54, r=33). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Source layer: 20x20 rounded square outline -->
    <path
        android:pathData="M41,34 H47 A7,7 0 0 1 54,41 V47 A7,7 0 0 1 47,54 H41 A7,7 0 0 1 34,47 V41 A7,7 0 0 1 41,34 Z"
        android:strokeColor="#AEDFD9"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- Upscaled layer: 30x30 rounded square fill -->
    <path
        android:pathData="M53,45 H67 A8,8 0 0 1 75,53 V67 A8,8 0 0 1 67,75 H53 A8,8 0 0 1 45,67 V53 A8,8 0 0 1 53,45 Z"
        android:fillColor="#4C9D9A" />
</vector>
