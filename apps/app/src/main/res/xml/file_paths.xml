<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Security fix: Restrict FileProvider to specific app-owned subdirectories
         instead of exposing the entire external storage root (".").
         This prevents other apps from accessing arbitrary files via the content provider. -->
    <external-files-path name="models" path="Documents/models/" />
    <external-files-path name="shared_images" path="Pictures/" />
    <!-- 默认输出根目录（未选 SAF 目录时 BatchOutputRepository 写入的公共
         Pictures/CrossScale），ACTION_VIEW 分发输出图需要它能被 FileProvider 映射；
         仍只暴露这一个子目录，不放开整个外部存储根。 -->
    <external-path name="public_pictures_output" path="Pictures/CrossScale/" />
    <cache-path name="cache" path="." />
    <files-path name="files" path="." />
</paths>
